CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/v2/16m.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions/v2/16m.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

CONFIG_EXAMPLE_MOUNT_SD_CARD=y
# CONFIG_EXAMPLE_USE_SDMMC_HOST is not set
CONFIG_EXAMPLE_PIN_MOSI=1
CONFIG_EXAMPLE_PIN_MISO=25
CONFIG_EXAMPLE_PIN_CLK=6
CONFIG_EXAMPLE_PIN_CS=26
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# CONFIG_BT_ENABLED is not set
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=80

# Enable C5 PSRAM because upload/cast requests can carry large image bodies.
# 中文：启用 C5 PSRAM，因为 upload/cast 请求可能携带较大的图片数据包。
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
# Preserve 96 KiB for explicit internal/DMA users such as WiFi and SPI drivers.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=98304

# Let large mbedTLS allocations follow the existing malloc threshold into PSRAM.
# CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC is not set
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y
# Avoid ESP32-C5 hardware AES runtime DMA allocation failures during bulk TLS reads.
# CONFIG_MBEDTLS_HARDWARE_AES is not set
CONFIG_MBEDTLS_AES_C=y

# Use USB Serial/JTAG as the primary console on the ESP32-C5 board.
# 中文：在 ESP32-C5 板上使用 USB Serial/JTAG 作为主控制台。
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
# CONFIG_ESP_CONSOLE_USB_CDC is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_CUSTOM is not set
# CONFIG_ESP_CONSOLE_NONE is not set
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=y
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
CONFIG_ESPTOOLPY_MONITOR_BAUD=921600

# CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE is not set
CONFIG_PM_ENABLE=y
CONFIG_ESP_ENABLE_PVT=y
CONFIG_PM_PROFILING=y
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_4=y
CONFIG_ESP_BROWNOUT_DET_LVL=4
CONFIG_ESP_TIMER_SHOW_EXPERIMENTAL=y
CONFIG_ESP_TIMER_TASK_AFFINITY_CPU0=y
# CONFIG_ESP_TIMER_TASK_AFFINITY_CPU1 is not set
CONFIG_ESP_TIMER_ISR_AFFINITY_CPU0=y
# CONFIG_ESP_TIMER_ISR_AFFINITY_CPU1 is not set
